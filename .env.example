# Copy this file to .env and fill in your own values to enable the
# "Save to Registry" / "Load from Registry" feature (Base Model, Enrich
# Base Model, and SPOKE sections). Without a valid GIT_REGISTRY_TOKEN, the
# registry UI shows a clear "not configured" message instead of erroring.
#
# GIT_REGISTRY_TOKEN needs write access to the target repo's contents
# (classic PAT with the `repo` scope, or a fine-grained PAT scoped to the
# registry repo with Contents: Read and write).
GIT_REGISTRY_TOKEN=

# Defaults shown below match this project's registry repo; override if you
# point the app at a different one.
GIT_REGISTRY_OWNER=MaheshK812210
GIT_REGISTRY_REPO=ModelRegitry
GIT_REGISTRY_BRANCH=main

# SPOKE: external LLM Gateway that turns attached .sql into an instruction
# JSON enrichment (POST {LLM_GATEWAY_URL}/v1/sql-to-instruction). Optional
# Bearer token. When unset, SPOKE uses a local offline fallback so the UI
# still works for demos/tests.
LLM_GATEWAY_URL=
LLM_GATEWAY_TOKEN=
